# Copy to .env and fill in. Never commit .env.

# Lane A: agent
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Photon Spectrum: project ID + secret from https://app.photon.codes
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Surfaces to start: any of imessage,terminal (comma-separated)
SURFACES=imessage,terminal
# Your own phone (E.164, e.g. +19195551234) for the voice-note test
DEMO_PHONE=
# Nudge an owner/approver after this many ms; escalate after MAX_REMINDERS nudges
REMINDER_MS=120000
MAX_REMINDERS=2

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Live vendor calls (optional): Conversational AI agent + imported phone number.
# VENDOR_PHONE is the number that plays the caterer (E.164). Empty = role-played call.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
VENDOR_PHONE=
# Daily voice briefing to everyone bound on iMessage, e.g. 08:30. Empty = off
BRIEFING_AT=

# Capital One Nessie: key from https://api.nessieisreal.com (log in with GitHub)
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Solana devnet. Secret key as a JSON byte array (solana-keygen file) or base58
SOLANA_RPC_URL=https://api.devnet.solana.com
# Demo rate: dollars on an invoice -> SOL actually sent on devnet
SOLANA_SOL_PER_USD=0.0001
SOLANA_SECRET_KEY=
SNOWFLAKE_AGENT_PAT=

# Lane A: HTTP for the website (GET /live SSE, GET /health)
AGENT_PORT=8787
AGENT_CORS_ORIGIN=*

# Lane C: Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Agent (Lane A) reads org data as this tier role, and answers people as their own tier role
SNOWFLAKE_ORG_ROLE=PHOTON_FINANCE
SNOWFLAKE_APP_ROLE=PHOTON_APP

# Lane C: Tiger Data
TIGER_DATABASE_URL=
# Lane A: password for TIGER_DATABASE_URL's user (wayfinder_agent; from lane C)
TIGER_PASSWORD=
# Set to 1 only if certificate verification fails on your network
TIGER_TLS_INSECURE=
# Lane C: sources for tiger:roles
TIGER_AGENT_PASSWORD=
TIGER_WEB_PASSWORD=

# Lane C: Darwin (lane A: set DARWIN_URL to use approved rules as route hints)
DARWIN_URL=
DARWIN_PORT=
DARWIN_CORS_ORIGINS=
