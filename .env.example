# Copy to .env and fill in. Never commit .env.

# Lane A: agent
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Photon Spectrum: project ID + secret from https://app.photon.codes
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Surfaces to start: any of imessage,terminal (comma-separated)
SURFACES=imessage,terminal
# Your own phone (E.164, e.g. +19195551234) for the voice-note test
DEMO_PHONE=
# Nudge an owner/approver after this many ms; escalate after MAX_REMINDERS nudges
REMINDER_MS=120000
MAX_REMINDERS=2

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Live vendor calls (optional): Conversational AI agent + imported phone number.
# VENDOR_PHONE is the number that plays the caterer (E.164). Empty = role-played call.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
VENDOR_PHONE=
# Daily voice briefing to everyone bound on iMessage, e.g. 08:30. Empty = off
BRIEFING_AT=

# Capital One Nessie: key from http://api.nessieisreal.com (log in with GitHub)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# Solana devnet. Secret key as a JSON byte array (solana-keygen file) or base58
SOLANA_RPC_URL=https://api.devnet.solana.com
# Demo rate: dollars on an invoice -> SOL actually sent on devnet
SOLANA_SOL_PER_USD=0.0001
SOLANA_SECRET_KEY=

# Lane C: Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Lane C: Tiger Data
TIGER_DATABASE_URL=

# Lane C: Darwin
DARWIN_URL=
